{
  "name": "atelier-raizes-mvp-workspace",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c magenta,cyan \"npm run dev -w @atelier-raizes/web\" \"npm run dev -w @atelier-raizes/api\"",
    "dev:web": "npm run dev -w @atelier-raizes/web",
    "dev:api": "npm run dev -w @atelier-raizes/api",
    "build": "npm run build -w @atelier-raizes/web",
    "build:web": "npm run build -w @atelier-raizes/web",
    "start:api": "npm run start -w @atelier-raizes/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
